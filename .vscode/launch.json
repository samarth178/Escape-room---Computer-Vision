{
  "version": "0.2.0",
  "configurations": [
    { "name": "Play (random puzzles)", "type": "debugpy", "request": "launch",
      "program": "${workspaceFolder}/main.py", "console": "integratedTerminal" },
    { "name": "Play demo (5 fixed levels)", "type": "debugpy", "request": "launch",
      "program": "${workspaceFolder}/main.py", "args": ["--demo"], "console": "integratedTerminal" },
    { "name": "Play without YOLO", "type": "debugpy", "request": "launch",
      "program": "${workspaceFolder}/main.py", "args": ["--no-yolo"], "console": "integratedTerminal" },
    { "name": "Run tests", "type": "debugpy", "request": "launch",
      "module": "pytest", "args": ["-q"], "cwd": "${workspaceFolder}", "console": "integratedTerminal" }
  ]
}
